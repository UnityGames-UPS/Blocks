  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The game settings are configurable in the settings menu.\n\nThe available
    Risk levels that can be selected are Low, Medium and High. The selected Risk
    changes the configuration of the Multipliers at the bottom of the game.\n\nThe
    game consists of 9 Blocks in a 3\xD73 grid. Each Block has 6 sides with a different
    color on each side. The available Risk level affects the amount of Blocks that
    need to form a winning cluster:\n\nLow: Land 3\u20139 colors in clusters to win\nMedium:
    Land 4\u20139 colors in clusters to win\nHigh: Land 5\u20139 colors in clusters
    to win"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
